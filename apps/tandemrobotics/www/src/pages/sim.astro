---
import GzSim from "@/components/gz-sim.vue";
import Layout from "@/layouts/layout.astro";
import "@/styles.css";
---

<Layout>
  <title>Live Simulation — Tandem Robotics</title>
  <div class="flex h-screen flex-col">
    <header
      class="flex items-center justify-between border-b border-fd-border px-6 py-3"
    >
      <a href="/" class="font-display text-lg">Tandem Robotics</a>
      <span class="font-display text-sm text-fd-muted-foreground">
        Live Simulation
      </span>
    </header>
    <div class="min-h-0 flex-1">
      <GzSim client:only="vue" />
    </div>
  </div>
</Layout>
