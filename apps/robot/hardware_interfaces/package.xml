<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_hardware_interfaces</name>
  <version>0.1.0</version>
  <description>
    ros2_control SystemInterface for diff drive platforms — commands and feedback over platform/motors topics
  </description>

  <maintainer email="mfarabi619@gmail.com">Mumtahin Farabi</maintainer>

  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>robot_platform_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <hardware_interface plugin="${prefix}/robot_hardware_interfaces.xml"/>
  </export>
</package>
