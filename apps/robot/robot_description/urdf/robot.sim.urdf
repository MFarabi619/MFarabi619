<?xml version="1.0"?>
<?xml-model href="https://raw.githubusercontent.com/ros/urdfdom/master/xsd/urdf.xsd" ?>
<robot name="robot">

  <link name="base_link"/>

  <link name="base_footprint">
  </link>
  <link name="chassis">
    <visual><geometry><mesh filename="package://robot_description/meshes/chassis.dae"/></geometry></visual>
    <collision><origin xyz="0 0 0.2873"/><geometry><box size="1.1500 1.0000 0.0254"/></geometry></collision>
  </link>
  <link name="rear_left_mount_link">
    <visual><geometry><mesh filename="package://robot_description/meshes/rear_left_mount_link.dae"/></geometry></visual>
    <inertial>
      <origin xyz="-0.0091 0.0135 -0.0392"/>
      <mass value="0.2518"/>
      <inertia ixx="5.463310e-4" ixy="2.070822e-5" ixz="-9.681193e-5" iyy="1.134640e-3" iyz="8.354465e-5" izz="6.916162e-4"/>
    </inertial>
  </link>
  <link name="rear_left_motor_link">
    <visual><geometry><mesh filename="package://robot_description/meshes/rear_left_motor_link.dae"/></geometry></visual>
  </link>
  <link name="rear_left_wheel_link">
    <visual><geometry><mesh filename="package://robot_description/meshes/rear_left_wheel_link.dae"/></geometry></visual>
    <collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.1749" length="0.1000"/></geometry></collision>
    <inertial>
      <origin xyz="0.0000 0.0000 -0.0000"/>
      <mass value="5.2861"/>
      <inertia ixx="5.890944e-2" ixy="0.000000e0" ixz="0.000000e0" iyy="1.094965e-1" iyz="0.000000e0" izz="5.890944e-2"/>
    </inertial>
  </link>
  <link name="rear_right_mount_link">
    <visual><geometry><mesh filename="package://robot_description/meshes/rear_right_mount_link.dae"/></geometry></visual>
    <inertial>
      <origin xyz="-0.0091 -0.0135 -0.0392"/>
      <mass value="0.2518"/>
      <inertia ixx="5.463310e-4" ixy="-2.070822e-5" ixz="-9.681193e-5" iyy="1.134640e-3" iyz="-8.354465e-5" izz="6.916162e-4"/>
    </inertial>
  </link>
  <link name="rear_right_motor_link">
    <visual><geometry><mesh filename="package://robot_description/meshes/rear_right_motor_link.dae"/></geometry></visual>
  </link>
  <link name="rear_right_wheel_link">
    <visual><geometry><mesh filename="package://robot_description/meshes/rear_right_wheel_link.dae"/></geometry></visual>
    <collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.1749" length="0.1000"/></geometry></collision>
    <inertial>
      <origin xyz="0.0000 -0.0000 -0.0000"/>
      <mass value="5.2861"/>
      <inertia ixx="5.890944e-2" ixy="0.000000e0" ixz="0.000000e0" iyy="1.094965e-1" iyz="0.000000e0" izz="5.890944e-2"/>
    </inertial>
  </link>
  <link name="front_left_mount_link">
    <visual><geometry><mesh filename="package://robot_description/meshes/front_left_mount_link.dae"/></geometry></visual>
    <inertial>
      <origin xyz="-0.0091 0.0135 -0.0392"/>
      <mass value="0.2518"/>
      <inertia ixx="5.463310e-4" ixy="2.070822e-5" ixz="-9.681193e-5" iyy="1.134640e-3" iyz="8.354465e-5" izz="6.916162e-4"/>
    </inertial>
  </link>
  <link name="front_left_motor_link">
    <visual><geometry><mesh filename="package://robot_description/meshes/front_left_motor_link.dae"/></geometry></visual>
  </link>
  <link name="front_left_wheel_link">
    <visual><geometry><mesh filename="package://robot_description/meshes/front_left_wheel_link.dae"/></geometry></visual>
    <collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.1749" length="0.1000"/></geometry></collision>
    <inertial>
      <origin xyz="0.0000 0.0000 -0.0000"/>
      <mass value="5.2861"/>
      <inertia ixx="5.890944e-2" ixy="0.000000e0" ixz="5.551115e-17" iyy="1.094965e-1" iyz="0.000000e0" izz="5.890944e-2"/>
    </inertial>
  </link>
  <link name="front_right_mount_link">
    <visual><geometry><mesh filename="package://robot_description/meshes/front_right_mount_link.dae"/></geometry></visual>
    <inertial>
      <origin xyz="-0.0091 -0.0135 -0.0392"/>
      <mass value="0.2518"/>
      <inertia ixx="5.463310e-4" ixy="-2.070822e-5" ixz="-9.681193e-5" iyy="1.134640e-3" iyz="-8.354465e-5" izz="6.916162e-4"/>
    </inertial>
  </link>
  <link name="front_right_motor_link">
    <visual><geometry><mesh filename="package://robot_description/meshes/front_right_motor_link.dae"/></geometry></visual>
  </link>
  <link name="front_right_wheel_link">
    <visual><geometry><mesh filename="package://robot_description/meshes/front_right_wheel_link.dae"/></geometry></visual>
    <collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.1749" length="0.1000"/></geometry></collision>
    <inertial>
      <origin xyz="0.0000 -0.0000 -0.0000"/>
      <mass value="5.2861"/>
      <inertia ixx="5.890944e-2" ixy="0.000000e0" ixz="5.551115e-17" iyy="1.094965e-1" iyz="0.000000e0" izz="5.890944e-2"/>
    </inertial>
  </link>

  <link name="inertial_link">
    <inertial>
      <origin xyz="-0.0787 0.0001 0.3193"/>
      <mass value="41.2746"/>
      <inertia ixx="3.877554e0" ixy="1.345498e-3" ixz="2.024260e-1" iyy="5.251737e0" iyz="-8.390746e-4" izz="8.885363e0"/>
    </inertial>
  </link>
  <joint name="inertial_joint" type="fixed">
    <parent link="chassis"/>
    <child link="inertial_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin xyz="0.0000 0.0000 0.0000" rpy="0.0000 0.0000 0.0000"/>
  </joint>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin xyz="0.0000 0.0000 0.0264" rpy="0.0000 0.0000 0.0000"/>
  </joint>

  <joint name="front_left_mount_joint" type="fixed">
    <parent link="chassis"/>
    <child link="front_left_mount_link"/>
    <origin xyz="0.4000 0.4742 0.2746" rpy="0.0000 0.0000 0.0000"/>
  </joint>

  <joint name="front_right_mount_joint" type="fixed">
    <parent link="chassis"/>
    <child link="front_right_mount_link"/>
    <origin xyz="0.4000 -0.4742 0.2746" rpy="0.0000 0.0000 0.0000"/>
  </joint>

  <joint name="rear_left_mount_joint" type="fixed">
    <parent link="chassis"/>
    <child link="rear_left_mount_link"/>
    <origin xyz="-0.4000 0.4742 0.2746" rpy="0.0000 0.0000 0.0000"/>
  </joint>

  <joint name="rear_right_mount_joint" type="fixed">
    <parent link="chassis"/>
    <child link="rear_right_mount_link"/>
    <origin xyz="-0.4000 -0.4742 0.2746" rpy="0.0000 0.0000 0.0000"/>
  </joint>

  <joint name="front_left_motor_joint" type="fixed">
    <parent link="front_left_mount_link"/>
    <child link="front_left_motor_link"/>
    <origin xyz="-0.0260 0.0660 -0.0732" rpy="0.0000 0.0000 0.0000"/>
  </joint>

  <joint name="front_right_motor_joint" type="fixed">
    <parent link="front_right_mount_link"/>
    <child link="front_right_motor_link"/>
    <origin xyz="-0.0260 -0.0660 -0.0732" rpy="0.0000 0.0000 0.0000"/>
  </joint>

  <joint name="rear_left_motor_joint" type="fixed">
    <parent link="rear_left_mount_link"/>
    <child link="rear_left_motor_link"/>
    <origin xyz="-0.0260 0.0660 -0.0732" rpy="0.0000 0.0000 0.0000"/>
  </joint>

  <joint name="rear_right_motor_joint" type="fixed">
    <parent link="rear_right_mount_link"/>
    <child link="rear_right_motor_link"/>
    <origin xyz="-0.0260 -0.0660 -0.0732" rpy="0.0000 0.0000 0.0000"/>
  </joint>

  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="front_left_motor_link"/>
    <child link="front_left_wheel_link"/>
    <origin xyz="0.0000 0.0450 0.0000" rpy="0.0000 0.0000 0.0000"/>
    <axis xyz="0.0 1.0 0.0"/>
  </joint>

  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="front_right_motor_link"/>
    <child link="front_right_wheel_link"/>
    <origin xyz="0.0000 -0.0450 0.0000" rpy="0.0000 0.0000 0.0000"/>
    <axis xyz="0.0 1.0 0.0"/>
  </joint>

  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="rear_left_motor_link"/>
    <child link="rear_left_wheel_link"/>
    <origin xyz="0.0000 0.0450 0.0000" rpy="0.0000 0.0000 0.0000"/>
    <axis xyz="0.0 1.0 0.0"/>
  </joint>

  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="rear_right_motor_link"/>
    <child link="rear_right_wheel_link"/>
    <origin xyz="0.0000 -0.0450 0.0000" rpy="0.0000 0.0000 0.0000"/>
    <axis xyz="0.0 1.0 0.0"/>
  </joint>

  <link name="camera_mount_link"/>
  <joint name="camera_mount_link_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_mount_link"/>
    <origin xyz="0.2000 0.0000 0.7500" rpy="0.0000 0.0000 0.0000"/>
  </joint>

  <link name="camera_link"/>
  <joint name="camera_link_joint" type="fixed">
    <parent link="camera_mount_link"/>
    <child link="camera_link"/>
    <origin xyz="0.0000 0.0000 0.0000" rpy="0.0000 0.3100 0.0000"/>
  </joint>

  <link name="camera_optical_frame"/>
  <joint name="camera_optical_frame_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0.0000 0.0000 0.0000" rpy="-1.5708 0.0000 -1.5708"/>
  </joint>

  <link name="gps_link"/>
  <joint name="gps_link_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps_link"/>
    <origin xyz="0.0000 0.0000 0.0000" rpy="0.0000 0.0000 0.0000"/>
  </joint>

  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <update_rate>15</update_rate>
      <always_on>true</always_on>
      <frame_id>camera_optical_frame</frame_id>
      <topic>camera/image_raw</topic>
      <camera>
        <horizontal_fov>1.2217</horizontal_fov>
        <image>
          <width>1280</width>
          <height>800</height>
        </image>
        <clip>
          <near>0.1</near>
          <far>100.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <gazebo reference="gps_link">
    <sensor name="gps" type="navsat">
      <always_on>1</always_on>
      <update_rate>1</update_rate>
      <frame_id>gps_link</frame_id>
      <topic>gps/fix</topic>
    </sensor>
  </gazebo>

  <ros2_control name="RobotHardware" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="front_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="front_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>package://robot_control/config/control.yaml</parameters>
      <ros>
        <remapping>~/cmd_vel:=/platform/cmd_vel</remapping>
        <remapping>~/reference:=/platform/cmd_vel</remapping>
        <remapping>~/odom:=/odom</remapping>
        <remapping>~/odometry:=/odom</remapping>
        <remapping>/tf:=tf</remapping>
        <remapping>/tf_static:=tf_static</remapping>
        <remapping>joint_states:=/joint_states</remapping>
      </ros>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>true</publish_link_pose>
      <publish_nested_model_pose>true</publish_nested_model_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <update_frequency>50</update_frequency>
    </plugin>
  </gazebo>

</robot>
