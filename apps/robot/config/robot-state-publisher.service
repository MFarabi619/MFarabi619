[Unit]
Description=robot_state_publisher (URDF TF tree)
After=zenoh-router.service
Wants=zenoh-router.service
PartOf=robot.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=mfarabi
Environment=RMW_IMPLEMENTATION=rmw_zenoh_cpp
Environment=ROS_DOMAIN_ID=0
Environment='ZENOH_CONFIG_OVERRIDE=mode="client";connect/endpoints=["tcp/localhost:7447"]'
ExecStartPre=/bin/bash -c 'until (exec 3<>/dev/tcp/127.0.0.1/7447) 2>/dev/null; do sleep 1; done'
ExecStart=/bin/sh -c 'exec /home/mfarabi/.pixi/bin/ros2 run robot_state_publisher robot_state_publisher --ros-args -p robot_description:="$(cat /home/mfarabi/robot_ws/config/robot.urdf)"'
Restart=on-failure
RestartSec=2
TimeoutStopSec=5

[Install]
WantedBy=robot.target
