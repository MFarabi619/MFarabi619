[Unit]
Description=ros2_control controller_manager (drives motors via local rgpiod)
After=zenoh-router.service robot-state-publisher.service rgpiod.service
Wants=zenoh-router.service robot-state-publisher.service rgpiod.service
PartOf=robot.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=mfarabi
Environment=RMW_IMPLEMENTATION=rmw_zenoh_cpp
Environment=ROS_DOMAIN_ID=0
Environment='ZENOH_CONFIG_OVERRIDE=mode="client";connect/endpoints=["tcp/localhost:7447"]'
ExecStartPre=/bin/bash -c 'until (exec 3<>/dev/tcp/127.0.0.1/7447) 2>/dev/null; do sleep 1; done'
ExecStart=/home/mfarabi/.pixi/bin/pixi run --manifest-path /home/mfarabi/robot_ws/pixi.toml controller-manager
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=50
Restart=on-failure
RestartSec=2
TimeoutStopSec=5

[Install]
WantedBy=robot.target
