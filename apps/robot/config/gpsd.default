DEVICES="/dev/ttyAMA0"
GPSD_OPTIONS="-G -n -s 9600"
USBAUTO="true"

# sudo cp gpsd.default /etc/default/gpsd
# sudo systemctl restart gpsd
#
# BeagleY-AI: /dev/ttyAMA0 (HAT pins 8/10, main_uart1) requires
# /overlays/k3-am67a-beagley-ai-uart-ttyama0.dtbo appended to the
# fdtoverlays line in /boot/firmware/extlinux/extlinux.conf
