[Unit]
Description=zenoh router (ROS 2 graph hub)
After=network-online.target
Wants=network-online.target
PartOf=robot.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=mfarabi
Environment=ROS_DOMAIN_ID=0
ExecStart=/home/mfarabi/.pixi/bin/ros2 run rmw_zenoh_cpp rmw_zenohd
Restart=on-failure
RestartSec=2
TimeoutStopSec=5

[Install]
WantedBy=robot.target
