[Unit]
Description=Orbbec Gemini 335L driver (ROS 2 — depth; point cloud is built off-board)
After=zenoh-router.service
Wants=zenoh-router.service
PartOf=robot.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=mfarabi
SupplementaryGroups=video
Environment=RMW_IMPLEMENTATION=rmw_zenoh_cpp
Environment=ROS_DOMAIN_ID=0
Environment='ZENOH_CONFIG_OVERRIDE=mode="client";connect/endpoints=["tcp/localhost:7447"]'
ExecStartPre=/bin/bash -c 'until (exec 3<>/dev/tcp/127.0.0.1/7447) 2>/dev/null; do sleep 1; done'
ExecStart=/home/mfarabi/.pixi/bin/ros2 launch /home/mfarabi/robot_ws/config/camera_0.launch.py
Restart=on-failure
RestartSec=2
TimeoutStopSec=5

[Install]
WantedBy=robot.target
