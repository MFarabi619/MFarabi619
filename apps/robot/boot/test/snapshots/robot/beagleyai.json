{
  "environment": {
    "PYTEST_CURRENT_TEST": "boot/test/test_launch_snapshot.py::test_launch_starts_the_same_nodes_as_the_snapshot[robot/beagleyai] (call)",
    "ZENOH_CONFIG_OVERRIDE": "mode=\"client\""
  },
  "events": [
    {
      "env": {
        "ZENOH_CONFIG_OVERRIDE": "mode=\"router\""
      },
      "executable": "rmw_zenohd",
      "kind": "node",
      "max_respawns": -1,
      "name": "zenoh_router",
      "namespace": "/",
      "package": "rmw_zenoh_cpp",
      "raw": true,
      "respawn_delay": 2.0,
      "ros_waittime": null
    },
    {
      "group": "beagleyai",
      "kind": "group",
      "namespace": "/beagleyai",
      "use_sim_time": null
    },
    {
      "anonymous": false,
      "executable": "robot_state_publisher",
      "kind": "node",
      "name": "robot_state_publisher",
      "namespace": "/beagleyai",
      "package": "robot_state_publisher",
      "params": {
        "robot_description": "mech/urdf/beagleyai/robot.urdf"
      },
      "remaps": {
        "/tf": "tf",
        "/tf_static": "tf_static"
      },
      "xacro_args": null
    },
    {
      "executable": "rc_pulse_motor_driver",
      "kind": "node",
      "max_respawns": -1,
      "name": null,
      "namespace": "/beagleyai",
      "package": "robot_drivers",
      "params": {
        "left_pwm_channel": 1,
        "left_pwm_chip": 4,
        "left_reversed": false,
        "max_wheel_speed": 11.435105774728417,
        "right_pwm_channel": 1,
        "right_pwm_chip": 3,
        "right_reversed": false
      },
      "respawn_delay": 2.0
    },
    {
      "executable": "ros2_control_node",
      "kind": "node",
      "max_respawns": -1,
      "name": "controller_manager",
      "namespace": "/beagleyai",
      "on_exit": "<callable spawn_controllers>",
      "package": "controller_manager",
      "param_files": [
        "control/config/control.yaml",
        {
          "tempfile": {
            "/**/diff_drive_controller": {
              "ros__parameters": {
                "angular.z.max_acceleration": 10.0,
                "angular.z.max_jerk": 70.0,
                "angular.z.max_velocity": 3.0,
                "linear.x.max_acceleration": 8.0,
                "linear.x.max_jerk": 60.0,
                "linear.x.max_velocity": 2.0,
                "wheel_radius": 0.1749,
                "wheel_separation": 1.1704
              }
            }
          }
        }
      ],
      "remap_qualifier": "controller_manager",
      "remaps": {
        "~/robot_description": "robot_description"
      },
      "respawn_delay": 2.0
    },
    {
      "cmd_args": [
        "joint_state_broadcaster",
        "diff_drive_controller",
        "--param-file",
        "control/config/control.yaml",
        "--param-file",
        {
          "tempfile": {
            "/**/diff_drive_controller": {
              "ros__parameters": {
                "angular.z.max_acceleration": 10.0,
                "angular.z.max_jerk": 70.0,
                "angular.z.max_velocity": 3.0,
                "linear.x.max_acceleration": 8.0,
                "linear.x.max_jerk": 60.0,
                "linear.x.max_velocity": 2.0,
                "wheel_radius": 0.1749,
                "wheel_separation": 1.1704
              }
            }
          }
        },
        "--controller-manager-timeout",
        "60",
        "--controller-ros-args",
        "-r ~/cmd_vel:=platform/cmd_vel -r /tf:=tf -r /tf_static:=tf_static"
      ],
      "executable": "spawner",
      "kind": "node",
      "name": "controller_spawner",
      "namespace": "/beagleyai",
      "package": "controller_manager"
    },
    {
      "executable": "twist_mux",
      "kind": "node",
      "max_respawns": -1,
      "name": "twist_mux",
      "namespace": "/beagleyai",
      "package": "twist_mux",
      "param_files": [
        "control/config/twist_mux.yaml"
      ],
      "remaps": {
        "cmd_vel_out": "platform/cmd_vel"
      },
      "respawn_delay": 2.0
    },
    {
      "executable": "foxglove_bridge",
      "kind": "node",
      "max_respawns": -1,
      "name": "foxglove_bridge",
      "namespace": "/beagleyai",
      "package": "foxglove_bridge",
      "params": {
        "best_effort_qos_topic_whitelist": [
          "/beagleyai/sensors/camera_[0-9]+/.*"
        ],
        "max_qos_depth": 5,
        "send_buffer_limit": 20000000,
        "topic_whitelist": [
          "/beagleyai/sensors/camera_[0-9]+/(color|depth)/image_raw/(compressed|compressedDepth)$",
          "/beagleyai/sensors/camera_[0-9]+/depth/image_view(/compressed)?$",
          "/beagleyai/sensors/camera_[0-9]+/(color|depth)/camera_info$",
          "/beagleyai/sensors/camera_[0-9]+/depth/points$",
          "/beagleyai/sensors/camera_[0-9]+/scan$",
          "/beagleyai/sensors/(gps|imu)_[0-9]+/.*",
          "/beagleyai/perception/.*",
          "/beagleyai/platform/.*",
          "/beagleyai/joy_teleop/cmd_vel$",
          "/beagleyai/tf(_static)?$",
          "/beagleyai/map$",
          "/beagleyai/local_costmap/costmap$",
          "/beagleyai/plan$",
          "/beagleyai/slam_toolbox/.*",
          "/beagleyai/diagnostics.*",
          "/beagleyai/robot_description$"
        ]
      },
      "respawn_delay": 2.0
    },
    {
      "executable": "aggregator_node",
      "kind": "node",
      "max_respawns": -1,
      "name": "diagnostic_aggregator",
      "namespace": "/beagleyai",
      "package": "diagnostic_aggregator",
      "param_files": [
        "boot/config/diagnostic_aggregator.yaml"
      ],
      "respawn_delay": 2.0
    },
    {
      "executable": "imu",
      "kind": "node",
      "max_respawns": -1,
      "name": "imu_0",
      "namespace": "/beagleyai",
      "package": "robot_drivers",
      "params": {
        "frame_id": "imu_0_link",
        "i2c_address": 74,
        "i2c_bus": 1,
        "rate_hz": 25.0
      },
      "remaps": {
        "activity": "sensors/imu_0/activity",
        "calibration_status": "sensors/imu_0/calibration_status",
        "data": "sensors/imu_0/data",
        "linear_acceleration": "sensors/imu_0/linear_acceleration",
        "mag": "sensors/imu_0/mag",
        "shake": "sensors/imu_0/shake",
        "stability": "sensors/imu_0/stability",
        "steps": "sensors/imu_0/steps"
      },
      "respawn_delay": 2.0
    },
    {
      "executable": "orbbec_gemini_335l",
      "kind": "node",
      "max_respawns": -1,
      "name": "orbbec_gemini_335l",
      "namespace": "/beagleyai",
      "package": "robot_drivers",
      "params": {
        "color_fps": 10,
        "color_height": 480,
        "color_width": 640,
        "depth_decimation": 2,
        "depth_fps": 15,
        "depth_height": 480,
        "depth_width": 848,
        "enable_depth": true
      },
      "remaps": {
        "color/camera_info": "sensors/camera_0/color/camera_info",
        "color/image_raw": "sensors/camera_0/color/image_raw",
        "color/image_raw/compressed": "sensors/camera_0/color/image_raw/compressed",
        "depth/camera_info": "sensors/camera_0/depth/camera_info",
        "depth/image_raw": "sensors/camera_0/depth/image_raw",
        "depth/image_raw/compressed": "sensors/camera_0/depth/image_raw/compressed"
      },
      "respawn_delay": 2.0
    },
    {
      "executable": "point_cloud_xyz_node",
      "kind": "node",
      "max_respawns": -1,
      "name": "depth_to_pointcloud",
      "namespace": "/beagleyai",
      "package": "depth_image_proc",
      "remaps": {
        "camera_info": "sensors/camera_0/depth/camera_info",
        "image_rect": "sensors/camera_0/depth/image_raw",
        "points": "sensors/camera_0/depth/points"
      },
      "respawn_delay": 2.0
    },
    {
      "executable": "pointcloud_to_laserscan_node",
      "kind": "node",
      "max_respawns": -1,
      "name": "pointcloud_to_laserscan",
      "namespace": "/beagleyai",
      "package": "pointcloud_to_laserscan",
      "params": {
        "max_height": 0.5,
        "min_height": 0.1,
        "range_max": 8.0,
        "range_min": 0.25,
        "scan_time": 0.06666666666666667,
        "target_frame": "base_link"
      },
      "remaps": {
        "/tf": "tf",
        "/tf_static": "tf_static",
        "cloud_in": "sensors/camera_0/depth/points",
        "scan": "sensors/camera_0/scan"
      },
      "respawn_delay": 2.0
    },
    {
      "executable": "collision_overlay",
      "kind": "node",
      "max_respawns": -1,
      "name": "collision_overlay",
      "namespace": "/beagleyai",
      "package": "robot_perception",
      "params": {
        "camera_info_topic": "sensors/camera_0/color/camera_info",
        "cloud_topic": "sensors/camera_0/depth/points",
        "overlay_topic": "perception/collision/overlay"
      },
      "remaps": {
        "/tf": "tf",
        "/tf_static": "tf_static"
      },
      "respawn_delay": 2.0
    },
    {
      "executable": "person_detector",
      "kind": "node",
      "max_respawns": -1,
      "name": "person_detector",
      "namespace": "/beagleyai",
      "package": "robot_perception",
      "params": {
        "depth_camera_info_topic": "sensors/camera_0/depth/camera_info",
        "depth_topic": "sensors/camera_0/depth/image_raw",
        "image_topic": "sensors/camera_0/color/image_raw",
        "max_detections_per_second": 10.0,
        "min_score": 0.3
      },
      "respawn_delay": 2.0
    },
    {
      "executable": "approach",
      "kind": "node",
      "max_respawns": -1,
      "name": "person_follow",
      "namespace": "/beagleyai",
      "package": "robot_perception",
      "params": {
        "command_smoothing_seconds": 0.1,
        "distance_damping": 0.4,
        "distance_deadband": 0.1,
        "distance_gain": 2.5,
        "max_angular_speed": 2.0,
        "max_backward_speed": 2.0,
        "max_forward_speed": 2.0,
        "max_missing_frames": 24,
        "standoff_distance": 1.5,
        "start_enabled": false,
        "steer_damping": 0.7,
        "steer_deadband": 0.05,
        "steer_gain": 1.5
      },
      "respawn_delay": 2.0
    }
  ],
  "launch": {
    "arguments": {
      "name": "beagleyai"
    },
    "file": "boot/launch/robot.launch.py",
    "function": "robot",
    "launch_this": {}
  }
}
