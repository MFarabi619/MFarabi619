      "respawn_delay": 2.0
    },
    {
      "executable": "planner_server",
      "kind": "node",
      "max_respawns": -1,
      "name": "planner_server",
      "namespace": "/taro",
      "package": "nav2_planner",
      "param_files": [
        "navigation/config/gps_navigation.yaml"
      ],
      "params": {},
      "remaps": {
        "/taro/global_costmap/sensors/camera_0/scan": "/taro/sensors/camera_0/scan",
        "/tf": "tf",
        "/tf_static": "tf_static"
