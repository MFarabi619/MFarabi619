{
  "environment": {
    "PYTEST_CURRENT_TEST": "boot/test/test_launch_snapshot.py::test_launch_starts_the_same_nodes_as_the_snapshot[robot/taro] (call)",
    "ZENOH_CONFIG_OVERRIDE": "mode=\"client\""
  },
  "events": [
    {
      "env": {
        "ZENOH_CONFIG_OVERRIDE": "mode=\"router\""
      },
      "executable": "rmw_zenohd",
      "kind": "node",
      "max_respawns": -1,
      "name": "zenoh_router",
      "namespace": "/",
      "package": "rmw_zenoh_cpp",
      "raw": true,
      "respawn_delay": 2.0,
      "ros_waittime": null
    },
    {
      "group": "taro",
      "kind": "group",
      "namespace": "/taro",
      "use_sim_time": null
    },
    {
      "anonymous": false,
      "executable": "robot_state_publisher",
      "kind": "node",
      "name": "robot_state_publisher",
      "namespace": "/taro",
      "package": "robot_state_publisher",
      "params": {
        "robot_description": "mech/urdf/taro/robot.urdf"
      },
      "remaps": {
        "/tf": "tf",
        "/tf_static": "tf_static"
      },
      "xacro_args": null
    },
    {
      "executable": "roboteq_motor_driver",
      "kind": "node",
      "max_respawns": -1,
      "name": null,
      "namespace": "/taro",
      "package": "robot_drivers",
      "params": {
        "baud_rate": 115200,
        "control_mode": "open_loop",
        "counts_per_revolution": 90,
        "flash": [
          "PMOD 7 1",
          "PMOD 8 1",
          "PINA 7 17",
          "PINA 8 33",
          "PPOL 7 0",
          "PPOL 8 1",
          "PMIN 7 0",
          "PMIN 8 0",
          "PMAX 7 3000",
          "PMAX 8 3000",
          "MDIR 1 0",
          "MDIR 2 0",
          "MMOD 1 0",
          "MMOD 2 0",
          "ALIM 1 300",
          "ALIM 2 300",
          "RWD 1000"
        ],
        "full_scale_wheel_speed": 11.435105774728417,
        "left_reversed": false,
        "right_reversed": true,
        "serial_port": "/dev/serial/by-id/usb-RoboteQ_RoboteQ_SBLMG2360T_GwBAABhQRUhMNTIg_207235674845-if00"
      },
      "respawn_delay": 2.0
    },
    {
      "executable": "ros2_control_node",
      "kind": "node",
      "max_respawns": -1,
      "name": "controller_manager",
      "namespace": "/taro",
      "on_exit": "<callable spawn_controllers>",
      "package": "controller_manager",
      "param_files": [
        "control/config/control.yaml",
        {
          "tempfile": {
            "/**/diff_drive_controller": {
              "ros__parameters": {
                "angular.z.max_acceleration": 7.5,
                "linear.x.max_acceleration": 5.0,
                "wheel_radius": 0.1749,
                "wheel_separation": 1.1704
              }
            }
          }
        }
      ],
      "remap_qualifier": "controller_manager",
      "remaps": {
        "~/robot_description": "robot_description"
      },
      "respawn_delay": 2.0
    },
    {
      "cmd_args": [
        "joint_state_broadcaster",
        "diff_drive_controller",
        "--param-file",
        "control/config/control.yaml",
        "--param-file",
        {
          "tempfile": {
            "/**/diff_drive_controller": {
              "ros__parameters": {
                "angular.z.max_acceleration": 7.5,
                "linear.x.max_acceleration": 5.0,
                "wheel_radius": 0.1749,
                "wheel_separation": 1.1704
              }
            }
          }
        },
        "--controller-manager-timeout",
        "60",
        "--controller-ros-args",
        "-r ~/cmd_vel:=platform/cmd_vel -r /tf:=tf -r /tf_static:=tf_static"
      ],
      "executable": "spawner",
      "kind": "node",
      "name": "controller_spawner",
      "namespace": "/taro",
      "package": "controller_manager"
    },
    {
      "executable": "twist_mux",
      "kind": "node",
      "max_respawns": -1,
      "name": "twist_mux",
      "namespace": "/taro",
      "package": "twist_mux",
      "param_files": [
        "control/config/twist_mux.yaml"
      ],
      "remaps": {
        "cmd_vel_out": "platform/cmd_vel"
      },
      "respawn_delay": 2.0
    },
    {
      "executable": "foxglove_bridge",
      "kind": "node",
      "max_respawns": -1,
      "name": "foxglove_bridge",
      "namespace": "/taro",
      "package": "foxglove_bridge",
      "params": {
        "best_effort_qos_topic_whitelist": [
          "/taro/sensors/camera_[0-9]+/.*"
        ],
        "max_qos_depth": 5,
        "send_buffer_limit": 20000000,
        "topic_whitelist": [
          "/taro/sensors/camera_[0-9]+/(color|depth)/image_raw/(compressed|compressedDepth)$",
          "/taro/sensors/camera_[0-9]+/depth/image_view(/compressed)?$",
          "/taro/sensors/camera_[0-9]+/(color|depth)/camera_info$",
          "/taro/sensors/camera_[0-9]+/depth/points$",
          "/taro/sensors/camera_[0-9]+/scan$",
          "/taro/sensors/(gps|imu)_[0-9]+/.*",
          "/taro/perception/.*",
          "/taro/platform/.*",
          "/taro/joy_teleop/cmd_vel$",
          "/taro/tf(_static)?$",
          "/taro/map$",
          "/taro/local_costmap/costmap$",
          "/taro/plan$",
          "/taro/slam_toolbox/.*",
          "/taro/diagnostics.*",
          "/taro/robot_description$"
        ]
      },
      "respawn_delay": 2.0
    },
    {
      "executable": "aggregator_node",
      "kind": "node",
      "max_respawns": -1,
      "name": "diagnostic_aggregator",
      "namespace": "/taro",
      "package": "diagnostic_aggregator",
      "param_files": [
        "boot/config/diagnostic_aggregator.yaml"
      ],
      "respawn_delay": 2.0
    },
    {
      "argv": [
        "<python>",
        "drivers/src/ublox_flash.py",
        "--port",
        "/dev/serial/by-id/usb-u-blox_AG_-_www.u-blox.com_u-blox_GNSS_receiver-if00",
        "CFG_RATE_MEAS=200",
        "CFG_RATE_NAV=1"
      ],
      "kind": "subprocess",
      "namespace": "/taro"
    },
    {
      "executable": "nmea_serial_driver",
      "kind": "node",
      "max_respawns": -1,
      "name": "nmea_navsat_driver",
      "namespace": "/taro",
      "package": "nmea_navsat_driver",
      "params": {
        "baud": 115200,
        "frame_id": "gps_link",
        "port": "/dev/serial/by-id/usb-u-blox_AG_-_www.u-blox.com_u-blox_GNSS_receiver-if00"
      },
      "remaps": {
        "fix": "sensors/gps_0/fix",
        "heading": "sensors/gps_0/heading",
        "time_reference": "sensors/gps_0/time_reference",
        "vel": "sensors/gps_0/vel"
      },
      "respawn_delay": 2.0
    },
    {
      "cmd": "gnssntripclient --server rtk2go.com --ntripversion 1.0 --mountpoint OsgoodeFarms --ntripuser farabi@tandemrobotics.ca --ntrippassword none --clioutput 2 --output /dev/serial/by-id/usb-u-blox_AG_-_www.u-blox.com_u-blox_GNSS_receiver-if00@115200",
      "kind": "process",
      "max_respawns": -1,
      "name": "ntrip_client",
      "namespace": "/taro",
      "respawn_delay": 10.0
    },
    {
      "executable": "ekf_node",
      "kind": "node",
      "max_respawns": -1,
      "name": "ekf_global",
      "namespace": "/taro",
      "package": "robot_localization",
      "param_files": [
        "control/config/localization.yaml"
      ],
      "remaps": {
        "/tf": "tf",
        "/tf_static": "tf_static"
      },
      "respawn_delay": 2.0
    },
    {
      "executable": "navsat_transform_node",
      "kind": "node",
      "max_respawns": -1,
      "name": "navsat_transform",
      "namespace": "/taro",
      "package": "robot_localization",
      "param_files": [
