      "respawn_delay": 2.0
    },
    {
      "executable": "harvest_lane_navigator",
      "kind": "node",
      "max_respawns": -1,
      "name": "harvest_lane_navigator",
      "namespace": "/taro",
      "package": "robot_perception",
      "params": {
        "camera_height_m": 0.4426,
        "camera_info_topic": "sensors/camera_0/color/camera_info",
        "camera_lateral_offset_m": 0.475,
        "depth_topic": "sensors/camera_0/depth/image_raw",
        "forward_speed_mps": 0.3,
        "mask_topic": "perception/canopy/mask/compressed",
        "max_angular_speed_radps": 0.55,
        "max_forward_speed_mps": 0.5,
        "odom_topic": "diff_drive_controller/odom",
        "row_pitch_m": 1.17,
        "start_enabled": false
