      "respawn_delay": 2.0
    },
    {
      "executable": "bt_navigator",
      "kind": "node",
      "max_respawns": -1,
      "name": "bt_navigator",
      "namespace": "/taro",
      "package": "nav2_bt_navigator",
      "param_files": [
