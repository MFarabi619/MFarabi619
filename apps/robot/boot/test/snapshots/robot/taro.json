        "depth_camera_info_topic": "sensors/camera_0/depth/camera_info",
        "depth_topic": "sensors/camera_0/depth/image_raw",
        "image_topic": "sensors/camera_0/color/image_raw",
        "max_detections_per_second": 10.0,
        "min_score": 0.3
      },
      "respawn_delay": 2.0
    },
    {
      "executable": "approach",
      "kind": "node",
      "max_respawns": -1,
      "name": "person_follow",
      "namespace": "/taro",
      "package": "robot_perception",
      "params": {
        "command_smoothing_seconds": 0.3,
        "distance_damping": 0.4,
        "distance_deadband": 0.25,
        "distance_gain": 0.9,
        "max_angular_speed": 0.7,
        "max_backward_speed": 0.7,
        "max_forward_speed": 0.7,
        "max_missing_frames": 24,
        "standoff_distance": 1.5,
        "start_enabled": false,
        "steer_damping": 0.7,
        "steer_deadband": 0.15,
        "steer_gain": 0.5
      },
      "respawn_delay": 2.0
