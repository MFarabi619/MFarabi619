    {
      "executable": "waypoint_follower",
      "kind": "node",
      "max_respawns": -1,
      "name": "waypoint_follower",
      "namespace": "/taro",
      "package": "nav2_waypoint_follower",
      "param_files": [
        "navigation/config/gps_navigation.yaml"
      ],
      "params": {},
      "remaps": {
        "/fromLL": "fromLL",
        "/tf": "tf",
        "/tf_static": "tf_static"
      },
      "respawn_delay": 2.0
    }
  ],
  "launch": {
    "arguments": {
      "name": "taro"
    },
    "file": "boot/launch/robot.launch.py",
    "function": "robot",
    "launch_this": {}
  }
}
