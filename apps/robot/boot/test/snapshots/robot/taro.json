      "respawn_delay": 2.0
    },
    {
      "kind": "wait_for_service",
      "namespace": "/taro",
      "service": "/taro/fromLL",
      "timeout": 120.0
    },
    {
      "executable": "controller_server",
      "kind": "node",
      "max_respawns": -1,
      "name": "controller_server",
      "namespace": "/taro",
      "package": "nav2_controller",
