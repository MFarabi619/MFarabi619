      ],
      "remaps": {
        "/tf": "tf",
        "/tf_static": "tf_static",
        "gps/filtered": "sensors/gps_0/filtered",
        "gps/fix": "sensors/gps_0/fix"
      },
      "respawn_delay": 2.0
    },
    {
      "executable": "orbbec_gemini_335l",
      "kind": "node",
      "max_respawns": -1,
      "name": "orbbec_gemini_335l",
      "namespace": "/taro",
      "package": "robot_drivers",
      "params": {
        "color_fps": 30,
        "color_height": 480,
        "color_width": 640,
        "depth_decimation": 2,
        "depth_fps": 15,
        "depth_height": 480,
        "depth_width": 848,
        "enable_depth": true
      },
      "remaps": {
        "color/camera_info": "sensors/camera_0/color/camera_info",
        "color/image_raw": "sensors/camera_0/color/image_raw",
        "color/image_raw/compressed": "sensors/camera_0/color/image_raw/compressed",
        "depth/camera_info": "sensors/camera_0/depth/camera_info",
        "depth/image_raw": "sensors/camera_0/depth/image_raw",
        "depth/image_raw/compressed": "sensors/camera_0/depth/image_raw/compressed"
      },
      "respawn_delay": 2.0
    },
    {
      "executable": "point_cloud_xyz_node",
      "kind": "node",
      "max_respawns": -1,
      "name": "depth_to_pointcloud",
      "namespace": "/taro",
      "package": "depth_image_proc",
      "remaps": {
        "camera_info": "sensors/camera_0/depth/camera_info",
        "image_rect": "sensors/camera_0/depth/image_raw",
        "points": "sensors/camera_0/depth/points"
      },
      "respawn_delay": 2.0
    },
    {
      "executable": "pointcloud_to_laserscan_node",
      "kind": "node",
      "max_respawns": -1,
      "name": "pointcloud_to_laserscan",
      "namespace": "/taro",
      "package": "pointcloud_to_laserscan",
      "params": {
        "max_height": 0.5,
        "min_height": 0.1,
        "range_max": 8.0,
        "range_min": 0.25,
        "scan_time": 0.06666666666666667,
        "target_frame": "base_link"
      },
      "remaps": {
        "/tf": "tf",
        "/tf_static": "tf_static",
        "cloud_in": "sensors/camera_0/depth/points",
        "scan": "sensors/camera_0/scan"
      },
      "respawn_delay": 2.0
    },
    {
      "executable": "collision_overlay",
      "kind": "node",
      "max_respawns": -1,
      "name": "collision_overlay",
      "namespace": "/taro",
      "package": "robot_perception",
      "params": {
        "camera_info_topic": "sensors/camera_0/color/camera_info",
        "cloud_topic": "sensors/camera_0/depth/points",
        "overlay_topic": "perception/collision/overlay"
      },
      "remaps": {
        "/tf": "tf",
        "/tf_static": "tf_static"
      },
      "respawn_delay": 2.0
    },
    {
      "executable": "person_detector",
      "kind": "node",
      "max_respawns": -1,
      "name": "person_detector",
      "namespace": "/taro",
      "package": "robot_perception",
