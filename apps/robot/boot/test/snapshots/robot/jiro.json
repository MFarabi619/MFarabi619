          "/jiro/sensors/camera_[0-9]+/depth/image_view(/compressed)?$",
          "/jiro/sensors/camera_[0-9]+/(color|depth)/camera_info$",
          "/jiro/sensors/camera_[0-9]+/depth/points$",
          "/jiro/sensors/camera_[0-9]+/scan$",
          "/jiro/sensors/(gps|imu)_[0-9]+/.*",
          "/jiro/perception/.*",
          "/jiro/platform/.*",
          "/jiro/joy_teleop/cmd_vel$",
          "/jiro/tf(_static)?$",
          "/jiro/map$",
          "/jiro/local_costmap/costmap$",
          "/jiro/plan$",
          "/jiro/slam_toolbox/.*",
          "/jiro/diagnostics.*",
          "/jiro/robot_description$"
