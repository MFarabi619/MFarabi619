{
  "environment": {
    "PYTEST_CURRENT_TEST": "boot/test/test_launch_snapshot.py::test_launch_starts_the_same_nodes_as_the_snapshot[robot/jiro] (call)",
    "ZENOH_CONFIG_OVERRIDE": "mode=\"client\""
  },
  "events": [
    {
      "env": {
        "ZENOH_CONFIG_OVERRIDE": "mode=\"router\""
      },
      "executable": "rmw_zenohd",
      "kind": "node",
      "max_respawns": -1,
      "name": "zenoh_router",
      "namespace": "/",
      "package": "rmw_zenoh_cpp",
      "raw": true,
      "respawn_delay": 2.0,
      "ros_waittime": null
    },
    {
      "group": "jiro",
      "kind": "group",
      "namespace": "/jiro",
      "use_sim_time": null
    },
    {
      "anonymous": false,
      "executable": "robot_state_publisher",
      "kind": "node",
      "name": "robot_state_publisher",
      "namespace": "/jiro",
      "package": "robot_state_publisher",
      "params": {
        "robot_description": "mech/urdf/jiro/robot.urdf"
      },
      "remaps": {
        "/tf": "tf",
        "/tf_static": "tf_static"
      },
      "xacro_args": null
    },
    {
      "executable": "pwm_dir_motor_driver",
      "kind": "node",
      "max_respawns": -1,
      "name": null,
      "namespace": "/jiro",
      "package": "robot_drivers",
      "params": {
        "gpio_chip": 0,
        "left_dir_line": 16,
        "left_forward_level": true,
        "left_pwm_channel": 0,
        "left_pwm_chip": 0,
        "max_wheel_speed": 13.093196112064037,
        "min_duty": 0.0,
        "pwm_frequency_hz": 20000.0,
        "right_dir_line": 26,
        "right_forward_level": false,
        "right_pwm_channel": 1,
        "right_pwm_chip": 0
      },
      "respawn_delay": 2.0
    },
    {
      "executable": "ros2_control_node",
      "kind": "node",
      "max_respawns": -1,
      "name": "controller_manager",
      "namespace": "/jiro",
      "on_exit": "<callable spawn_controllers>",
      "package": "controller_manager",
      "param_files": [
        "control/config/control.yaml",
        {
          "tempfile": {
            "/**/diff_drive_controller": {
              "ros__parameters": {
                "angular.z.max_acceleration": 10.0,
                "angular.z.max_jerk": 70.0,
                "angular.z.max_velocity": 3.0,
                "linear.x.max_acceleration": 8.0,
                "linear.x.max_jerk": 60.0,
                "linear.x.max_velocity": 2.29,
                "wheel_radius": 0.1749,
                "wheel_separation": 0.5704
              }
            }
          }
        }
      ],
      "remap_qualifier": "controller_manager",
      "remaps": {
        "~/robot_description": "robot_description"
      },
      "respawn_delay": 2.0
    },
    {
      "cmd_args": [
        "joint_state_broadcaster",
        "diff_drive_controller",
        "--param-file",
        "control/config/control.yaml",
        "--param-file",
        {
          "tempfile": {
            "/**/diff_drive_controller": {
              "ros__parameters": {
                "angular.z.max_acceleration": 10.0,
                "angular.z.max_jerk": 70.0,
                "angular.z.max_velocity": 3.0,
                "linear.x.max_acceleration": 8.0,
                "linear.x.max_jerk": 60.0,
                "linear.x.max_velocity": 2.29,
                "wheel_radius": 0.1749,
                "wheel_separation": 0.5704
              }
            }
          }
        },
        "--controller-manager-timeout",
        "60",
        "--controller-ros-args",
        "-r ~/cmd_vel:=platform/cmd_vel -r /tf:=tf -r /tf_static:=tf_static"
      ],
      "executable": "spawner",
      "kind": "node",
      "name": "controller_spawner",
      "namespace": "/jiro",
      "package": "controller_manager"
    },
    {
