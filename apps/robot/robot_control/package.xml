<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_control</name>
  <version>0.1.0</version>
  <description>
    Controllers and bringup for the rover — diff_drive_controller over ros2_control
  </description>

  <maintainer email="mfarabi619@gmail.com">Mumtahin Farabi</maintainer>

  <license>GPL-3.0-only</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>controller_manager</exec_depend>
  <exec_depend>diff_drive_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>robot_hardware_interfaces</exec_depend>
  <exec_depend>robot_description</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
