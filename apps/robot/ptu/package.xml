<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_ptu</name>
  <version>0.1.0</version>
  <description>Standalone pan-tilt-unit driver: drives PCA9685 servos over remote GPIO (rgpiod) and echoes pan/tilt joint states.</description>

  <maintainer email="mfarabi619@gmail.com">Mumtahin Farabi</maintainer>

  <license>GPL-3.0-only</license>

  <url type="website">https://github.com/MFarabi619/MFarabi619/tree/main/apps/robot</url>
  <url type="bugtracker">https://github.com/mfarabi619/mfarabi619/issues</url>
  <url type="repository">https://github.com/mfarabi619/mfarabi619</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
