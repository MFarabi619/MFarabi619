<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_machines</name>
  <version>0.1.0</version>
  <description>Machine descriptions: one robot.yaml per machine and the typed model that reads them.</description>
  <maintainer email="mfarabi619@gmail.com">Mumtahin Farabi</maintainer>
  <license>GPL-3.0-only</license>

  <url type="website">https://github.com/MFarabi619/MFarabi619/tree/main/apps/robot</url>
  <url type="bugtracker">https://github.com/mfarabi619/mfarabi619/issues</url>
  <url type="repository">https://github.com/mfarabi619/mfarabi619</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
