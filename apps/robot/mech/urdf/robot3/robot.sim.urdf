<?xml version="1.0"?>
<?xml-model href="https://raw.githubusercontent.com/ros/urdfdom/master/xsd/urdf.xsd" ?>
<robot name="robot">

  <link name="base_link"/>

  <link name="base_footprint">
  </link>
  <link name="front_left_caster_link">
    <collision><geometry><sphere radius="0.1396"/></geometry></collision>
  </link>
  <link name="front_right_caster_link">
    <collision><geometry><sphere radius="0.1396"/></geometry></collision>
  </link>
  <link name="chassis">
    <visual><geometry><mesh filename="package://robot_description/meshes/robot3/chassis.dae"/></geometry></visual>
    <collision><origin xyz="0 0 0.2873"/><geometry><box size="1.2192 1.0000 0.0254"/></geometry></collision>
  </link>
  <link name="rear_left_mount_link">
    <visual><geometry><mesh filename="package://robot_description/meshes/robot3/rear_left_mount_link.dae"/></geometry></visual>
    <inertial>
      <origin xyz="-0.0091 0.0135 -0.0392"/>
      <mass value="0.2518"/>
      <inertia ixx="5.463310e-4" ixy="2.070822e-5" ixz="-9.681193e-5" iyy="1.134640e-3" iyz="8.354465e-5" izz="6.916162e-4"/>
    </inertial>
  </link>
  <link name="rear_left_motor_link">
    <visual><geometry><mesh filename="package://robot_description/meshes/robot3/rear_left_motor_link.dae"/></geometry></visual>
  </link>
  <link name="rear_left_wheel_link">
    <visual><geometry><mesh filename="package://robot_description/meshes/robot3/rear_left_wheel_link.dae"/></geometry></visual>
    <collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.1749" length="0.1000"/></geometry></collision>
    <inertial>
      <origin xyz="0.0000 0.0000 -0.0000"/>
      <mass value="5.2861"/>
      <inertia ixx="5.890944e-2" ixy="-4.440892e-16" ixz="0.000000e0" iyy="1.094965e-1" iyz="0.000000e0" izz="5.890944e-2"/>
    </inertial>
  </link>
  <link name="rear_right_mount_link">
    <visual><geometry><mesh filename="package://robot_description/meshes/robot3/rear_right_mount_link.dae"/></geometry></visual>
    <inertial>
      <origin xyz="-0.0091 -0.0135 -0.0392"/>
      <mass value="0.2518"/>
      <inertia ixx="5.463310e-4" ixy="-2.070822e-5" ixz="-9.681193e-5" iyy="1.134640e-3" iyz="-8.354465e-5" izz="6.916162e-4"/>
    </inertial>
  </link>
  <link name="rear_right_motor_link">
    <visual><geometry><mesh filename="package://robot_description/meshes/robot3/rear_right_motor_link.dae"/></geometry></visual>
  </link>
  <link name="rear_right_wheel_link">
    <visual><geometry><mesh filename="package://robot_description/meshes/robot3/rear_right_wheel_link.dae"/></geometry></visual>
    <collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.1749" length="0.1000"/></geometry></collision>
    <inertial>
      <origin xyz="0.0000 -0.0000 -0.0000"/>
      <mass value="5.2861"/>
      <inertia ixx="5.890944e-2" ixy="2.220446e-16" ixz="-1.110223e-16" iyy="1.094965e-1" iyz="0.000000e0" izz="5.890944e-2"/>
    </inertial>
  </link>

  <link name="inertial_link">
    <inertial>
      <origin xyz="0.1571 0.0038 0.3435"/>
      <mass value="63.6981"/>
      <inertia ixx="1.661315e1" ixy="3.692125e-2" ixz="1.842789e0" iyy="1.102772e1" iyz="1.885838e-2" izz="2.404056e1"/>
    </inertial>
  </link>
  <joint name="inertial_joint" type="fixed">
    <parent link="chassis"/>
    <child link="inertial_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin xyz="0.0000 0.0000 0.0000" rpy="0.0000 0.0000 0.0000"/>
  </joint>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin xyz="0.0000 0.0000 0.0264" rpy="0.0000 0.0000 0.0000"/>
  </joint>

  <joint name="rear_left_mount_joint" type="fixed">
    <parent link="chassis"/>
    <child link="rear_left_mount_link"/>
    <origin xyz="-0.5246 0.4742 0.2746" rpy="0.0000 0.0000 0.0000"/>
  </joint>

  <joint name="rear_right_mount_joint" type="fixed">
    <parent link="chassis"/>
    <child link="rear_right_mount_link"/>
    <origin xyz="-0.5246 -0.4742 0.2746" rpy="0.0000 0.0000 0.0000"/>
  </joint>

  <joint name="front_left_caster_joint" type="fixed">
    <parent link="chassis"/>
    <child link="front_left_caster_link"/>
    <origin xyz="0.4682 0.5508 0.1222" rpy="0.0000 0.0000 0.0000"/>
  </joint>

  <joint name="front_right_caster_joint" type="fixed">
    <parent link="chassis"/>
    <child link="front_right_caster_link"/>
    <origin xyz="0.4682 -0.5508 0.1222" rpy="0.0000 0.0000 0.0000"/>
  </joint>

  <joint name="rear_left_motor_joint" type="fixed">
    <parent link="rear_left_mount_link"/>
    <child link="rear_left_motor_link"/>
    <origin xyz="-0.0260 0.0660 -0.0732" rpy="0.0000 0.0000 0.0000"/>
  </joint>

  <joint name="rear_right_motor_joint" type="fixed">
    <parent link="rear_right_mount_link"/>
    <child link="rear_right_motor_link"/>
    <origin xyz="-0.0260 -0.0660 -0.0732" rpy="0.0000 0.0000 0.0000"/>
  </joint>

  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="rear_left_motor_link"/>
    <child link="rear_left_wheel_link"/>
    <origin xyz="0.0000 0.0450 0.0000" rpy="0.0000 0.0000 0.0000"/>
    <axis xyz="0.0 1.0 0.0"/>
  </joint>

  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="rear_right_motor_link"/>
    <child link="rear_right_wheel_link"/>
    <origin xyz="0.0000 -0.0450 0.0000" rpy="0.0000 0.0000 0.0000"/>
    <axis xyz="0.0 1.0 0.0"/>
  </joint>

  <link name="camera_mount_link"/>
  <joint name="camera_mount_link_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_mount_link"/>
    <origin xyz="0.2000 0.0000 0.7500" rpy="0.0000 0.0000 0.0000"/>
  </joint>

  <link name="camera_0_link"/>
  <joint name="camera_0_link_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_0_link"/>
    <origin xyz="0.5750 0.5000 0.3100" rpy="0.0000 0.3100 0.0000"/>
  </joint>

  <link name="camera_0_color_optical_frame"/>
  <joint name="camera_0_color_optical_frame_joint" type="fixed">
    <parent link="camera_0_link"/>
    <child link="camera_0_color_optical_frame"/>
    <origin xyz="0.0000 0.0000 0.0000" rpy="-1.5708 0.0000 -1.5708"/>
  </joint>

  <link name="imu_0_link"/>
  <joint name="imu_0_link_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_0_link"/>
    <origin xyz="0.0000 0.0000 0.3000" rpy="0.0000 0.0000 0.0000"/>
  </joint>

  <gazebo reference="front_left_caster_link">
    <mu1>0</mu1>
    <mu2>0</mu2>
    <kp>1000000</kp>
    <kd>100</kd>
    <minDepth>0.001</minDepth>
  </gazebo>

  <gazebo reference="front_right_caster_link">
    <mu1>0</mu1>
    <mu2>0</mu2>
    <kp>1000000</kp>
    <kd>100</kd>
    <minDepth>0.001</minDepth>
  </gazebo>

  <gazebo reference="camera_0_link">
    <sensor name="camera_0" type="rgbd_camera">
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <frame_id>camera_0_color_optical_frame</frame_id>
      <camera>
        <horizontal_fov>1.2217</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.25</near>
            <far>20</far>
          </clip>
        </depth_camera>
      </camera>
    </sensor>
  </gazebo>

  <gazebo reference="imu_0_link">
    <sensor name="imu_0" type="imu">
      <update_rate>25</update_rate>
      <always_on>true</always_on>
      <frame_id>imu_0_link</frame_id>
    </sensor>
  </gazebo>

  <ros2_control name="DiffDriveHardware" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>package://robot_control/config/control.yaml</parameters>
      <ros>
        <namespace>robot3</namespace>
        <remapping>~/cmd_vel:=platform/cmd_vel</remapping>
        <remapping>~/reference:=platform/cmd_vel</remapping>
        <remapping>~/odom:=odom</remapping>
        <remapping>~/odometry:=odom</remapping>
        <remapping>joint_states:=joint_states</remapping>
        <remapping>robot_description:=/robot_description</remapping>
      </ros>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>true</publish_link_pose>
      <publish_nested_model_pose>true</publish_nested_model_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <update_frequency>50</update_frequency>
    </plugin>
  </gazebo>

</robot>
