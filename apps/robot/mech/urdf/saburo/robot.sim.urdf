<?xml version="1.0"?>
<?xml-model href="https://raw.githubusercontent.com/ros/urdfdom/master/xsd/urdf.xsd" ?>
<robot name="robot">

  <link name="base_link"/>

  <link name="base_footprint">
  </link>

  <link name="chassis">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="100"/>
      <inertia ixx="4.8333" ixy="0" ixz="0" iyy="15.9375" iyz="0" izz="19.2708"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
      <geometry><mesh filename="package://robot_description/meshes/saburo/chassis.dae"/></geometry>
    </visual>
    <visual>
      <origin xyz="0.0035 -0.4207 0.4465" rpy="0 0 3.1416"/>
      <geometry><mesh filename="package://robot_description/meshes/saburo/mounting.dae"/></geometry>
    </visual>
    <collision>
      <origin xyz="-0.0003 -0.0002 0.3051" rpy="0 0 0"/>
      <geometry><box size="1.2243 1.0039 0.8303"/></geometry>
    </collision>
  </link>

  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin xyz="0 0 -0.2601" rpy="0 0 0"/>
  </joint>

  <link name="front_left_wheel_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="15"/>
      <inertia ixx="0.4156" ixy="0" ixz="0" iyy="0.675" iyz="0" izz="0.4156"/>
    </inertial>
    <visual>
      <origin xyz="0.0250 0.0031 0.0409" rpy="0 0 0"/>
      <geometry><mesh filename="package://robot_description/meshes/saburo/wheel.dae"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.3014" length="0.135"/></geometry>
    </collision>
  </link>
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="chassis"/>
    <child link="front_left_wheel_link"/>
    <origin xyz="0.3725 0.525 0.0413" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="rear_left_wheel_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="15"/>
      <inertia ixx="0.4156" ixy="0" ixz="0" iyy="0.675" iyz="0" izz="0.4156"/>
    </inertial>
    <visual>
      <origin xyz="0.0250 0.0031 0.0409" rpy="0 0 0"/>
      <geometry><mesh filename="package://robot_description/meshes/saburo/wheel.dae"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.3014" length="0.135"/></geometry>
    </collision>
  </link>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="chassis"/>
    <child link="rear_left_wheel_link"/>
    <origin xyz="-0.3725 0.525 0.0413" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="front_right_wheel_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="15"/>
      <inertia ixx="0.4156" ixy="0" ixz="0" iyy="0.675" iyz="0" izz="0.4156"/>
    </inertial>
    <visual>
      <origin xyz="-0.0250 -0.0031 0.0409" rpy="0 0 3.1416"/>
      <geometry><mesh filename="package://robot_description/meshes/saburo/wheel.dae"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.3014" length="0.135"/></geometry>
    </collision>
  </link>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="chassis"/>
    <child link="front_right_wheel_link"/>
    <origin xyz="0.3725 -0.525 0.0413" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="rear_right_wheel_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="15"/>
      <inertia ixx="0.4156" ixy="0" ixz="0" iyy="0.675" iyz="0" izz="0.4156"/>
    </inertial>
    <visual>
      <origin xyz="-0.0250 -0.0031 0.0409" rpy="0 0 3.1416"/>
      <geometry><mesh filename="package://robot_description/meshes/saburo/wheel.dae"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.3014" length="0.135"/></geometry>
    </collision>
  </link>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="chassis"/>
    <child link="rear_right_wheel_link"/>
    <origin xyz="-0.3725 -0.525 0.0413" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="camera_0_link">
    <visual>
      <origin xyz="-0.01 0 0.015" rpy="0 0 0"/>
      <geometry><mesh filename="package://zed_description/meshes/zed2i.stl"/></geometry>
      <material name="zed2i"><color rgba="0.25 0.25 0.25 1.0"/></material>
    </visual>
  </link>
  <joint name="camera_0_link_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_0_link"/>
    <origin xyz="0.53 0 0.114" rpy="0 0 0"/>
  </joint>

  <link name="camera_0_color_optical_frame"/>
  <joint name="camera_0_color_optical_frame_joint" type="fixed">
    <parent link="camera_0_link"/>
    <child link="camera_0_color_optical_frame"/>
    <origin xyz="-0.01 0.06 0.015" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <link name="gps_link"/>
  <joint name="gps_link_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps_link"/>
    <origin xyz="0 0 0.114" rpy="0 0 0"/>
  </joint>

  <ros2_control name="DiffDriveHardware" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="front_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="front_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>package://robot_control/config/control.yaml</parameters>
      <ros>
        <namespace>saburo</namespace>
        <remapping>~/cmd_vel:=platform/cmd_vel</remapping>
        <remapping>~/reference:=platform/cmd_vel</remapping>
        <remapping>~/odom:=odom</remapping>
        <remapping>~/odometry:=odom</remapping>
        <remapping>joint_states:=joint_states</remapping>
        <remapping>robot_description:=/saburo/robot_description</remapping>
      </ros>
    </plugin>
  </gazebo>

  <gazebo reference="front_left_wheel_link">
    <mu1>0.5</mu1>
    <mu2>0.5</mu2>
    <fdir1>1 0 0</fdir1>
  </gazebo>
  <gazebo reference="rear_left_wheel_link">
    <mu1>0.5</mu1>
    <mu2>0.5</mu2>
    <fdir1>1 0 0</fdir1>
  </gazebo>
  <gazebo reference="front_right_wheel_link">
    <mu1>0.5</mu1>
    <mu2>0.5</mu2>
    <fdir1>1 0 0</fdir1>
  </gazebo>
  <gazebo reference="rear_right_wheel_link">
    <mu1>0.5</mu1>
    <mu2>0.5</mu2>
    <fdir1>1 0 0</fdir1>
  </gazebo>
  <gazebo reference="camera_0_link">
    <sensor name="camera_0" type="rgbd_camera">
      <pose>-0.01 0.06 0.015 0 0 0</pose>
      <update_rate>15</update_rate>
      <always_on>true</always_on>
      <frame_id>camera_0_color_optical_frame</frame_id>
      <camera>
        <horizontal_fov>1.9199</horizontal_fov>
        <image>
          <width>1280</width>
          <height>720</height>
        </image>
        <clip>
          <near>0.3</near>
          <far>20</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.3</near>
            <far>20</far>
          </clip>
        </depth_camera>
      </camera>
    </sensor>
  </gazebo>
  <gazebo reference="gps_link">
    <sensor name="gps" type="navsat">
      <always_on>true</always_on>
      <update_rate>1</update_rate>
      <frame_id>gps_link</frame_id>
    </sensor>
  </gazebo>

</robot>
