<?xml version="1.0"?>
<?xml-model href="https://raw.githubusercontent.com/ros/urdfdom/master/xsd/urdf.xsd" ?>
<robot name="robot">

  <link name="base_link"/>

  <link name="base_footprint">
  </link>

  <link name="chassis">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="100"/>
      <inertia ixx="4.8333" ixy="0" ixz="0" iyy="15.9375" iyz="0" izz="19.2708"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
      <geometry><mesh filename="package://robot_description/meshes/saburo/chassis.dae"/></geometry>
    </visual>
    <visual>
      <origin xyz="0.0035 -0.4207 0.4465" rpy="0 0 3.1416"/>
      <geometry><mesh filename="package://robot_description/meshes/saburo/mounting.dae"/></geometry>
    </visual>
    <collision>
      <origin xyz="-0.0003 -0.0002 0.3051" rpy="0 0 0"/>
      <geometry><box size="1.2243 1.0039 0.8303"/></geometry>
    </collision>
  </link>

  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin xyz="0 0 -0.2601" rpy="0 0 0"/>
  </joint>

  <link name="front_left_wheel_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="15"/>
      <inertia ixx="0.4156" ixy="0" ixz="0" iyy="0.675" iyz="0" izz="0.4156"/>
    </inertial>
    <visual>
      <origin xyz="0.0250 0.0031 0.0409" rpy="0 0 0"/>
      <geometry><mesh filename="package://robot_description/meshes/saburo/wheel.dae"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.3014" length="0.135"/></geometry>
    </collision>
  </link>
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="chassis"/>
    <child link="front_left_wheel_link"/>
    <origin xyz="0.3725 0.525 0.0413" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="rear_left_wheel_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="15"/>
      <inertia ixx="0.4156" ixy="0" ixz="0" iyy="0.675" iyz="0" izz="0.4156"/>
    </inertial>
    <visual>
      <origin xyz="0.0250 0.0031 0.0409" rpy="0 0 0"/>
      <geometry><mesh filename="package://robot_description/meshes/saburo/wheel.dae"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.3014" length="0.135"/></geometry>
    </collision>
  </link>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="chassis"/>
    <child link="rear_left_wheel_link"/>
    <origin xyz="-0.3725 0.525 0.0413" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="front_right_wheel_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="15"/>
      <inertia ixx="0.4156" ixy="0" ixz="0" iyy="0.675" iyz="0" izz="0.4156"/>
    </inertial>
    <visual>
      <origin xyz="-0.0250 -0.0031 0.0409" rpy="0 0 3.1416"/>
      <geometry><mesh filename="package://robot_description/meshes/saburo/wheel.dae"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.3014" length="0.135"/></geometry>
    </collision>
  </link>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="chassis"/>
    <child link="front_right_wheel_link"/>
    <origin xyz="0.3725 -0.525 0.0413" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="rear_right_wheel_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="15"/>
      <inertia ixx="0.4156" ixy="0" ixz="0" iyy="0.675" iyz="0" izz="0.4156"/>
    </inertial>
    <visual>
      <origin xyz="-0.0250 -0.0031 0.0409" rpy="0 0 3.1416"/>
      <geometry><mesh filename="package://robot_description/meshes/saburo/wheel.dae"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.3014" length="0.135"/></geometry>
    </collision>
  </link>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="chassis"/>
    <child link="rear_right_wheel_link"/>
    <origin xyz="-0.3725 -0.525 0.0413" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="gps_link"/>
  <joint name="gps_link_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps_link"/>
    <origin xyz="0 0 0.114" rpy="0 0 0"/>
  </joint>

  <ros2_control name="DiffDriveHardware" type="system">
    <hardware>
      <plugin>robot_drivers/DiffDriveHardware</plugin>
    </hardware>
    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

</robot>
