<mujoco model="scene">

  <option cone="elliptic" impratio="10" noslip_iterations="3"/>

  <statistic center="0.4 0 0.4" extent="1"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="2d" name="apple_texture" file="${APPLE_ASSETS}/texture_map.png"/>
    <material name="apple_material" texture="apple_texture" specular="0.5" shininess="0.5"/>
    <mesh name="apple_mesh" file="${APPLE_ASSETS}/textured.obj"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="ground" type="plane" size="2 2 0.1" rgba="0.35 0.35 0.35 1" friction="1.0 0.005 0.0001"/>
    <body name="apple" pos="0.5 0.0 0.05">
      <freejoint name="apple_free"/>
      <inertial pos="0 0 0" mass="0.18" diaginertia="0.00012 0.00012 0.00012"/>
      <geom name="apple_visual" type="mesh" mesh="apple_mesh" material="apple_material" contype="0" conaffinity="0" group="2" mass="0"/>
      <geom name="apple" type="mesh" mesh="apple_mesh" group="3" mass="0.18" friction="1.0 0.005 0.0001" condim="6"/>
    </body>
  </worldbody>
</mujoco>
