<mujoco_inputs>
  <raw_inputs>
    <option integrator="implicitfast"/>

    <default>
      <default class="visual">
        <geom group="2" type="mesh" contype="0" conaffinity="0"/>
      </default>
      <default class="collision">
        <geom group="3" type="mesh"/>
      </default>
    </default>

    <actuator>
      <position name="joint_1" joint="joint_1" kp="2000" kv="100" forcerange="-210 210" ctrlrange="-6.2832 6.2832"/>
      <position name="joint_2" joint="joint_2" kp="2000" kv="100" forcerange="-210 210" ctrlrange="-6.2832 6.2832"/>
      <position name="joint_3" joint="joint_3" kp="2000" kv="100" forcerange="-210 210" ctrlrange="-6.2832 6.2832"/>
