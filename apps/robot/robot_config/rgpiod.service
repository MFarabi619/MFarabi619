[Unit]
After=network.target
Description=lg remote GPIO daemon (rgpiod)

[Service]
Type=simple
Restart=on-failure
ExecStart=/usr/bin/rgpiod -c /var/lib/rgpiod -w /var/lib/rgpiod

[Install]
WantedBy=multi-user.target

# One clean unit replacing the packaged /usr/lib unit + override drop-in:
# sudo cp rgpiod.service /etc/systemd/system/
# sudo rm -rf /etc/systemd/system/rgpiod.service.d
# sudo systemctl daemon-reload
# sudo systemctl restart rgpiod
# sudo ss -ltnp | grep 8889
