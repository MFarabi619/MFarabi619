config APPS_NUTTX_ZIG
	tristate "Zig teleop pendant (zigzag TUI)"
	default n
	---help---
		Zig teleop pendant built on the zigzag TUI framework, rendered
		over the serial console. Arrow keys / WASD set linear and angular
		commands; space stops; q quits.

if APPS_NUTTX_ZIG

config APPS_NUTTX_ZIG_PROGNAME
	string "Program name"
	default "nuttx_zig"

config APPS_NUTTX_ZIG_PRIORITY
	int "Task priority"
	default 100

config APPS_NUTTX_ZIG_STACKSIZE
	int "Stack size"
	default 32768

endif
