diff --git a/packages/suite-base/src/providers/ExtensionCatalogProvider/seedBundledExtensions.ts b/packages/suite-base/src/providers/ExtensionCatalogProvider/seedBundledExtensions.ts
new file mode 100644
index 000000000..8c61993cc
--- /dev/null
+++ b/packages/suite-base/src/providers/ExtensionCatalogProvider/seedBundledExtensions.ts
@@ -0,0 +1,38 @@
+// SPDX-FileCopyrightText: Copyright (C) 2023-2026 Bayerische Motoren Werke Aktiengesellschaft (BMW AG)<lichtblick@bmwgroup.com>
+// SPDX-License-Identifier: MPL-2.0
+
+import Logger from "@lichtblick/log";
+import { IExtensionLoader } from "@lichtblick/suite-base/services/extension/IExtensionLoader";
+
+const log = Logger.getLogger(__filename);
+
+export async function seedBundledExtensions(
+  loaders: readonly IExtensionLoader[],
+  bundledExtensionUrls: readonly string[],
+): Promise<void> {
+  if (bundledExtensionUrls.length === 0) {
+    return;
+  }
+
+  const browserLoader = loaders.find(
+    (loader) => loader.namespace === "local" && loader.type === "browser",
+  );
+  if (!browserLoader) {
+    return;
+  }
+
+  for (const url of bundledExtensionUrls) {
+    try {
+      const response = await fetch(url);
+      if (!response.ok) {
+        log.warn(`Bundled extension fetch failed: ${url} (${response.status})`);
+        continue;
+      }
+      const foxeFileData = new Uint8Array(await response.arrayBuffer());
+      await browserLoader.installExtension({ foxeFileData });
+      log.info(`Installed bundled extension: ${url}`);
+    } catch (err) {
+      log.error(`Failed to install bundled extension ${url}`, err);
+    }
+  }
