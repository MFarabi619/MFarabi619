#include <zephyr/dt-bindings/pinctrl/esp32s3-pinctrl.h>


&psram0 {
	size = <DT_SIZE_M(8)>;
};

/*
 * NOTE: Adeept Robot HAT (PCA9685 servos over I2C). Uncomment this block plus
 * the I2C/PCA9685 lines in the .conf, and comment out the MD30C block below —
 * one hat on the bench at a time.
 *
 * &xiao_i2c {
 *	status = "okay";
 *
 *	pca9685: pca9685@40 {
 *		compatible = "nxp,pca9685-pwm";
 *		reg = <0x40>;
 *		#pwm-cells = <3>;
 *		status = "okay";
 *	};
 * };
 */

/*
 * NOTE: uncomment to drive the Adeept HAT's Left onboard RGB LED. Wire 3 jumpers
 * XIAO -> HAT 40-pin header: D0 (GPIO1) -> pin 33 (R), D1 (GPIO2) -> pin 35 (G),
 * D2 (GPIO3) -> pin 27 (B). Common-anode / active-low, so channels are `inverted`
 * (higher duty = brighter). Drive ~2 kHz: pwm usec <ledc-dev> 0 500 <pulse>.
 *
 * &pinctrl {
 *	ledc0_rgb: ledc0_rgb {
 *		group1 {
 *			pinmux = <LEDC_CH0_GPIO1>, <LEDC_CH1_GPIO2>, <LEDC_CH2_GPIO3>;
 *			output-enable;
 *		};
 *	};
 * };
 *
 * &ledc0 {
 *	pinctrl-0 = <&ledc0_rgb>;
 *	pinctrl-names = "default";
 *	status = "okay";
 *	#address-cells = <1>;
 *	#size-cells = <0>;
 *
 *	channel0@0 { reg = <0x0>; timer = <0>; inverted; };
 *	channel1@1 { reg = <0x1>; timer = <0>; inverted; };
 *	channel2@2 { reg = <0x2>; timer = <0>; inverted; };
 * };
 */

&pinctrl {
	ledc0_md30c: ledc0_md30c {
		group1 {
			pinmux = <LEDC_CH0_GPIO1>, <LEDC_CH1_GPIO4>;
			output-enable;
		};
	};
};

&ledc0 {
	pinctrl-0 = <&ledc0_md30c>;
	pinctrl-names = "default";
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel0@0 {
		reg = <0x0>;
		timer = <0>;
	};

	channel1@1 {
		reg = <0x1>;
		timer = <1>;
	};
};
